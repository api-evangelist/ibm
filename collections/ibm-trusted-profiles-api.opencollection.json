{
  "opencollection": "1.0.0",
  "info": {
    "name": "IBM Cloud IAM API Keys Trusted Profiles API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
